# =========================================================================
# WildGuard AI - Backend Environment Variables (.env)
# =========================================================================

# Port and Binding
PORT=5000
HOST=0.0.0.0

# CORS Allowed Origin for Vercel deployment (e.g. https://wildguard-ai-beta.vercel.app)
FRONTEND_URL=https://wildguard-ai-beta.vercel.app

# External AI YOLOv8 Detection Service (Default local port 8000)
AI_URL=http://127.0.0.1:8000
AI_SERVICE_URL=http://127.0.0.1:8000/health
AI_DETECT_URL=http://127.0.0.1:8000/detect
